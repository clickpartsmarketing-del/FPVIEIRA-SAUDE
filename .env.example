# Copie para .env (o .gitignore já bloqueia .env*) e preencha com os valores
# do projeto Supabase (Dashboard -> Settings -> API). Use SOMENTE a chave anon
# (public) no front-end - nunca a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
